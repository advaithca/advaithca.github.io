<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=TeX+Gyre+Pagella&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'TeX Gyre Pagella', serif;
      max-width: 750px;
      margin: 3rem auto;
      padding: 0 1rem;
      font-size: 18px;
      line-height: 1.6;
      background: #fdfaf6; /* ← Off-white background */
      color: #111;
    }

    h1, h2, h3 {
      font-weight: bold; /* ← Bolder headings */
      border-bottom: 1px solid #ddd;
      padding-bottom: 0.3em;
      margin-top: 2em;
    }

    h1 {
      font-size: 2rem;
      text-align: center;
      border: none;
      margin-bottom: 2rem;
    }

    hr {
      border: none;
      border-top: 1px solid #eee;
      margin: 2rem 0;
    }

    a {
      color: #005fa3;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  {{ content | safe }}
</body>
</html>
